<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>安全执行系统 - 控制面板</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        gold: {
                            400: '#D4AF37',
                            500: '#FFD700',
                            600: '#B8860B'
                        },
                        dark: {
                            800: '#1E1E1E',
                            900: '#121212'
                        }
                    },
                    fontFamily: {
                        mono: ['JetBrains Mono', 'Consolas', 'monospace']
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer utilities {
            .bg-gradient-gold {
                background: linear-gradient(135deg, #1E1E1E 0%, #121212 100%);
            }
            .text-shadow-gold {
                text-shadow: 0 0 8px rgba(212, 175, 55, 0.5);
            }
            .animate-pulse-slow {
                animation: pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
            }
        }
    </style>
</head>
<body class="min-h-screen bg-dark-900 text-gray-200 font-sans">
    <!-- 顶部导航 -->
    <header class="bg-dark-800 border-b border-gold-400/30 sticky top-0 z-50">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <i class="fa fa-shield text-gold-500 text-2xl"></i>
                <h1 class="text-xl font-bold text-gold-500 text-shadow-gold">安全执行系统控制面板</h1>
            </div>
            <div id="system-status" class="flex items-center space-x-2">
                <span class="text-sm">系统状态:</span>
                <span id="status-indicator" class="px-3 py-1 rounded-full text-xs font-medium bg-green-600 text-white">运行中</span>
            </div>
        </div>
    </header>

    <main class="container mx-auto px-4 py-6">
        <!-- 状态卡片区域 -->
        <section class="mb-8">
            <h2 class="text-lg font-semibold text-gold-500 mb-4 flex items-center">
                <i class="fa fa-dashboard mr-2"></i>安全状态监控
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- 暂停状态 -->
                <div class="bg-dark-800 rounded-xl p-4 border border-gold-400/30 hover:border-gold-400/60 transition-all">
                    <div class="flex justify-between items-start mb-2">
                        <h3 class="text-gray-300 font-medium">系统暂停状态</h3>
                        <i class="fa fa-pause-circle text-gold-500"></i>
                    </div>
                    <div class="flex items-center">
                        <span id="paused-status" class="text-xl font-bold text-green-500">未暂停</span>
                        <span id="paused-indicator" class="ml-3 w-3 h-3 rounded-full bg-green-500 animate-pulse"></span>
                    </div>
                </div>
                
                <!-- Token白名单 -->
                <div class="bg-dark-800 rounded-xl p-4 border border-gold-400/30 hover:border-gold-400/60 transition-all">
                    <div class="flex justify-between items-start mb-2">
                        <h3 class="text-gray-300 font-medium">Token白名单</h3>
                        <i class="fa fa-lock text-gold-500"></i>
                    </div>
                    <p id="token-whitelist" class="text-gray-400 text-sm">加载中...</p>
                </div>
                
                <!-- 队列长度 -->
                <div class="bg-dark-800 rounded-xl p-4 border border-gold-400/30 hover:border-gold-400/60 transition-all">
                    <div class="flex justify-between items-start mb-2">
                        <h3 class="text-gray-300 font-medium">任务队列长度</h3>
                        <i class="fa fa-tasks text-gold-500"></i>
                    </div>
                    <div class="flex items-center">
                        <span id="queue-length" class="text-xl font-bold text-gold-500">0</span>
                        <span class="ml-2 text-gray-400 text-sm">任务</span>
                    </div>
                </div>
                
                <!-- 最后中断 -->
                <div class="bg-dark-800 rounded-xl p-4 border border-gold-400/30 hover:border-gold-400/60 transition-all">
                    <div class="flex justify-between items-start mb-2">
                        <h3 class="text-gray-300 font-medium">最后中断时间</h3>
                        <i class="fa fa-history text-gold-500"></i>
                    </div>
                    <p id="last-interrupt" class="text-gray-400 text-sm">无</p>
                </div>
            </div>
        </section>

        <!-- 操作按钮区域 -->
        <section class="mb-8">
            <h2 class="text-lg font-semibold text-gold-500 mb-4 flex items-center">
                <i class="fa fa-control mr-2"></i>系统操作
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <button id="pause-btn" class="bg-dark-800 hover:bg-red-900/30 text-white py-3 px-6 rounded-xl border border-red-500/30 hover:border-red-500 transition-all flex items-center justify-center space-x-2 shadow-lg hover:shadow-red-500/20">
                    <i class="fa fa-pause"></i>
                    <span>暂停系统</span>
                </button>
                <button id="resume-btn" class="bg-dark-800 hover:bg-green-900/30 text-white py-3 px-6 rounded-xl border border-green-500/30 hover:border-green-500 transition-all flex items-center justify-center space-x-2 shadow-lg hover:shadow-green-500/20">
                    <i class="fa fa-play"></i>
                    <span>恢复系统</span>
                </button>
                <button id="view-logs-btn" class="bg-dark-800 hover:bg-blue-900/30 text-white py-3 px-6 rounded-xl border border-blue-500/30 hover:border-blue-500 transition-all flex items-center justify-center space-x-2 shadow-lg hover:shadow-blue-500/20">
                    <i class="fa fa-file-text"></i>
                    <span>查看操作日志</span>
                </button>
            </div>
        </section>

        <!-- 日志显示区域 -->
        <section>
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-semibold text-gold-500 flex items-center">
                    <i class="fa fa-terminal mr-2"></i>实时日志
                </h2>
                <button id="clear-logs-btn" class="text-sm text-gray-400 hover:text-gold-500 transition-colors">
                    <i class="fa fa-trash mr-1"></i>清除日志
                </button>
            </div>
            <div class="bg-dark-800 rounded-xl p-4 border border-gold-400/30">
                <div id="logs-container" class="h-80 overflow-y-auto font-mono text-sm text-gray-300 whitespace-pre-wrap" style="scrollbar-width: thin; scrollbar-color: #D4AF37 #1E1E1E;">
                    <div class="text-gray-500 italic">正在连接系统...</div>
                </div>
            </div>
        </section>
    </main>

    <footer class="mt-8 py-4 bg-dark-800 border-t border-gold-400/30">
        <div class="container mx-auto px-4 text-center text-gray-500 text-sm">
            <p>安全执行系统 © 2024 | L3.5闭环执行系统</p>
        </div>
    </footer>

    <script>
        // 全局配置
        const CONFIG = {
            BASE_URL: 'http://localhost:1819',
            LOGS_LIMIT: 50,
            REFRESH_INTERVAL: 3000 // 3秒刷新一次状态
        };
        
        // 统一配置BASE变量
        const BASE = "http://localhost:1819";

        // 日志数组
        let logs = [];

        // DOM 元素
        const elements = {
            pausedStatus: document.getElementById('paused-status'),
            pausedIndicator: document.getElementById('paused-indicator'),
            tokenWhitelist: document.getElementById('token-whitelist'),
            queueLength: document.getElementById('queue-length'),
            lastInterrupt: document.getElementById('last-interrupt'),
            statusIndicator: document.getElementById('status-indicator'),
            pauseBtn: document.getElementById('pause-btn'),
            resumeBtn: document.getElementById('resume-btn'),
            viewLogsBtn: document.getElementById('view-logs-btn'),
            clearLogsBtn: document.getElementById('clear-logs-btn'),
            logsContainer: document.getElementById('logs-container')
        };

        // 初始化
        function init() {
            addEventListeners();
            // 启动定时刷新
            setInterval(refreshStatus, 3000);
            refreshStatus();
        }

        // 添加事件监听器
        function addEventListeners() {
            elements.pauseBtn.addEventListener('click', pauseSystem);
            elements.resumeBtn.addEventListener('click', resumeSystem);
            elements.viewLogsBtn.addEventListener('click', viewOperatorLogs);
            elements.clearLogsBtn.addEventListener('click', clearLogs);
        }

        // 获取系统状态
        async function fetchSystemStatus() {
            try {
                // 模拟获取系统状态（实际应从API获取）
                const mockStatus = {
                    paused: false,
                    tokens: ['token_123', 'token_456'],
                    tasks: 0,
                    last_interrupt: '从未中断'
                };

                updateCards(mockStatus);
                logMessage(`[状态更新] 系统运行正常`, 'info');
            } catch (error) {
                logMessage(`[错误] 获取系统状态失败: ${error.message}`, 'error');
                updateStatusIndicator('error');
            }
        }
        
        // 定时刷新状态
        async function refreshStatus(){
          try {
            console.log("请求已发送: /status");
            const r = await fetch(`${BASE}/status`);
            const s = await r.json();
            console.log("响应成功: /status", s);
            // 更新卡片：暂停状态/白名单/队列长度/最后中断时间、右上角“系统状态”
            updateCards(s);
            updateHeartbeatTime(); // “上次通信时间：yyyy-mm-dd hh:mm:ss”
          } catch (e) {
            console.warn("连接失败，准备重试...");
            showDisconnected(); // 灯变红、文案“未连接”
          }
        }
        
        // 更新状态卡片
        function updateCards(status) {
            // 更新暂停状态
            elements.pausedStatus.textContent = status.paused ? '已暂停' : '未暂停';
            elements.pausedStatus.className = status.paused ? 'text-xl font-bold text-red-500' : 'text-xl font-bold text-green-500';
            elements.pausedIndicator.className = status.paused ? 'ml-3 w-3 h-3 rounded-full bg-red-500' : 'ml-3 w-3 h-3 rounded-full bg-green-500 animate-pulse';
            
            // 更新Token白名单
            elements.tokenWhitelist.textContent = status.tokens?.join(', ') || '无';
            
            // 更新队列长度
            elements.queueLength.textContent = status.tasks || 0;
            
            // 更新最后中断时间
            elements.lastInterrupt.textContent = status.last_interrupt || '无';
            
            // 更新系统状态指示器
            updateStatusIndicator(status.paused ? 'paused' : 'running');
        }
        
        // 更新心跳时间
        function updateHeartbeatTime() {
            const now = new Date();
            const timeStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}:${String(now.getSeconds()).padStart(2, '0')}`;
            
            // 如果需要显示心跳时间，可以在这里添加DOM元素
            // 或者只是记录在日志中
            console.log(`上次通信时间: ${timeStr}`);
        }
        
        // 显示断开连接状态
        function showDisconnected() {
            updateStatusIndicator('error');
            logMessage(`[错误] 连接失败，系统可能未运行`, 'error');
        }
        
        // 追加日志
        function appendLog(message) {
            logMessage(message, 'action');
        }



        // 更新状态指示器
        function updateStatusIndicator(state) {
            switch (state) {
                case 'running':
                    elements.statusIndicator.textContent = '运行中';
                    elements.statusIndicator.className = 'px-3 py-1 rounded-full text-xs font-medium bg-green-600 text-white';
                    break;
                case 'paused':
                    elements.statusIndicator.textContent = '已暂停';
                    elements.statusIndicator.className = 'px-3 py-1 rounded-full text-xs font-medium bg-yellow-600 text-white';
                    break;
                case 'error':
                    elements.statusIndicator.textContent = '错误';
                    elements.statusIndicator.className = 'px-3 py-1 rounded-full text-xs font-medium bg-red-600 text-white';
                    break;
            }
        }

        // 暂停系统
        async function pauseSystem() {
            try {
                logMessage(`[操作] 正在暂停系统...`, 'action');
                // 实际调用API
                const response = await fetch(`${BASE}/pause`, { method: 'POST' });
                const result = await response.json();
                
                appendLog("【操作】暂停系统");
                logMessage(`[成功] ${result.message || '系统已暂停'}`, 'success');
                refreshStatus();
            } catch (error) {
                logMessage(`[错误] 暂停系统失败: ${error.message}`, 'error');
            }
        }

        // 恢复系统
        async function resumeSystem() {
            try {
                logMessage(`[操作] 正在恢复系统...`, 'action');
                // 实际调用API
                const response = await fetch(`${BASE}/resume`, { method: 'POST' });
                const result = await response.json();
                
                appendLog("【操作】恢复系统");
                logMessage(`[成功] ${result.message || '系统已恢复'}`, 'success');
                refreshStatus();
            } catch (error) {
                logMessage(`[错误] 恢复系统失败: ${error.message}`, 'error');
            }
        }

        // 查看操作日志
        async function viewOperatorLogs() {
            try {
                logMessage(`[操作] 正在获取操作日志...`, 'action');
                // 调用日志接口
                loadLogs();
            } catch (error) {
                logMessage(`[错误] 获取操作日志失败: ${error.message}`, 'error');
            }
        }
        
        // 加载日志
        async function loadLogs(){
          try {
            const r = await fetch(`${BASE}/logs`);
            const j = await r.json();
            renderLogs(j.logs);
            logMessage(`[成功] 获取到 ${j.logs?.length || 0} 条系统日志`, 'success');
          } catch (error) {
            logMessage(`[错误] 加载日志失败: ${error.message}`, 'error');
          }
        }
        
        // 渲染日志
        function renderLogs(logArray) {
            // 清空当前日志
            logs = [];
            
            // 添加新日志
            if (logArray && Array.isArray(logArray)) {
                logArray.forEach(log => {
                    logMessage(`[系统日志] ${log}`, 'info');
                });
            }
            
            updateLogsDisplay();
        }

        // 记录日志
        function logMessage(message, type = 'info') {
            const timestamp = new Date().toLocaleTimeString();
            let colorClass = '';
            let icon = '';
            
            switch (type) {
                case 'error':
                    colorClass = 'text-red-500';
                    icon = 'fa-exclamation-circle';
                    break;
                case 'success':
                    colorClass = 'text-green-500';
                    icon = 'fa-check-circle';
                    break;
                case 'warning':
                    colorClass = 'text-yellow-500';
                    icon = 'fa-exclamation-triangle';
                    break;
                case 'action':
                    colorClass = 'text-blue-400';
                    icon = 'fa-cog';
                    break;
                case 'info':
                default:
                    colorClass = 'text-gray-300';
                    icon = 'fa-info-circle';
                    break;
            }
            
            const logEntry = `[${timestamp}] <i class="fa ${icon} ${colorClass}"></i> ${message}`;
            logs.push(logEntry);
            
            // 限制日志数量
            if (logs.length > CONFIG.LOGS_LIMIT) {
                logs.shift();
            }
            
            updateLogsDisplay();
        }

        // 更新日志显示
        function updateLogsDisplay() {
            elements.logsContainer.innerHTML = logs.join('<br>');
            // 自动滚动到底部
            elements.logsContainer.scrollTop = elements.logsContainer.scrollHeight;
        }

        // 清除日志
        function clearLogs() {
            logs = [];
            updateLogsDisplay();
            logMessage(`[操作] 日志已清除`, 'action');
        }

        // 页面加载完成后初始化
        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>