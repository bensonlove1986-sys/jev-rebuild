// ==UserScript==
// @name         JEV 桌面控制面板
// @namespace    http://tampermonkey.net/
// @version      1.0.0
// @description  JEV Tampermonkey插件浮动控制面板（中文界面版）
// @author       JEV Team
// @match        *://*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    // 注入TailwindCSS样式
    function injectTailwindCSS() {
        const link = document.createElement('link');
        link.href = 'https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css';
        link.rel = 'stylesheet';
        document.head.appendChild(link);
    }

    // 注入自定义样式
    function injectCustomStyles() {
        const style = document.createElement('style');
        style.textContent = `
            #jev-control-panel {
                position: fixed;
                bottom: 20px;
                right: 20px;
                z-index: 9999;
                transition: all 0.3s ease;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            }
            
            #jev-control-panel.collapsed {
                height: 40px;
                width: 40px;
            }
            
            #jev-control-panel .panel-content {
                transition: opacity 0.3s ease;
            }
            
            #jev-control-panel.collapsed .panel-content {
                display: none;
            }
            
            #jev-drag-handle {
                cursor: move;
                user-select: none;
                font-family: '微软雅黑', 'PingFang SC', sans-serif;
            }
            
            .jev-status-indicator {
                display: inline-block;
                width: 10px;
                height: 10px;
                border-radius: 50%;
                margin-right: 5px;
            }
            
            .jev-status-connected {
                background-color: #4ade80;
            }
            
            .jev-status-disconnected {
                background-color: #f87171;
            }
            
            .jev-status-reconnecting {
                background-color: #facc15;
            }
            
            #jev-collapse-btn {
                cursor: pointer;
                transition: transform 0.3s ease;
            }
            
            #jev-collapse-btn.collapsed {
                transform: rotate(180deg);
            }
            
            .panel-content {
                font-family: '微软雅黑', 'PingFang SC', sans-serif;
            }
        `;
        document.head.appendChild(style);
    }

    // 创建控制面板HTML结构
    function createControlPanel() {
        const panel = document.createElement('div');
        panel.id = 'jev-control-panel';
        panel.className = 'bg-gray-800 text-white rounded-lg overflow-hidden w-72';
        
        panel.innerHTML = `
            <div class="flex justify-between items-center p-2 bg-gray-700">
                <div id="jev-drag-handle" class="text-xs font-medium">JEV 桌面控制面板</div>
                <div id="jev-collapse-btn" class="text-xs px-2 py-1">折叠</div>
            </div>
            
            <div class="panel-content p-3">
                <!-- 状态显示区域 -->
                <div class="mb-3">
                    <div class="text-xs text-gray-400 mb-1">插件版本</div>
                    <div id="jev-version" class="text-sm">v1.0.0</div>
                </div>
                
                <div class="mb-3">
                    <div class="text-xs text-gray-400 mb-1">连接状态</div>
                    <div id="jev-connection-status" class="text-sm">
                        <span class="jev-status-indicator jev-status-disconnected"></span>
                        <span>未连接</span>
                    </div>
                </div>
                
                <div class="mb-3">
                    <div class="text-xs text-gray-400 mb-1">最近操作</div>
                    <div id="jev-last-action" class="text-sm">无</div>
                    <div id="jev-last-action-time" class="text-xs text-gray-500">从未</div>
                </div>
                
                <div class="mb-3">
                    <div class="text-xs text-gray-400 mb-1">通信状态</div>
                    <div id="jev-last-communication" class="text-xs text-gray-500">上次通信时间：--</div>
                    <div id="jev-retry-status" class="text-xs text-yellow-400" style="display: none;">重试中...</div>
                </div>
                
                <!-- 按钮区域 -->
                <div class="grid grid-cols-2 gap-2">
                    <button id="jev-ping-btn" class="bg-blue-600 hover:bg-blue-700 text-xs py-1 px-2 rounded transition-colors" title="立即检测本地代理是否在线">
                        检测连接
                    </button>
                    <button id="jev-test-btn" class="bg-green-600 hover:bg-green-700 text-xs py-1 px-2 rounded transition-colors" title="向代理发送测试命令并显示结果">
                        测试动作
                    </button>
                </div>
            </div>
        `;
        
        document.body.appendChild(panel);
        return panel;
    }

    // 更新状态显示
    function updateStatusDisplay() {
        // 读取插件版本
        if (window.__JEV_PLUGIN_STATUS && window.__JEV_PLUGIN_STATUS.version) {
            document.getElementById('jev-version').textContent = `v${window.__JEV_PLUGIN_STATUS.version}`;
        }
        
        // 读取连接状态
        if (window.__JEV_PLUGIN_STATUS && window.__JEV_PLUGIN_STATUS.connected !== undefined) {
            const statusElement = document.getElementById('jev-connection-status');
            const indicator = statusElement.querySelector('.jev-status-indicator');
            const statusText = statusElement.querySelector('span:last-child');
            
            if (window.__JEV_PLUGIN_STATUS.connected) {
                indicator.className = 'jev-status-indicator jev-status-connected';
                statusText.textContent = '已连接';
                document.getElementById('jev-retry-status').style.display = 'none';
            } else if (window.__JEV_PLUGIN_STATUS.reconnecting) {
                indicator.className = 'jev-status-indicator jev-status-reconnecting';
                statusText.textContent = '正在重连';
                document.getElementById('jev-retry-status').style.display = 'block';
            } else {
                indicator.className = 'jev-status-indicator jev-status-disconnected';
                statusText.textContent = '未连接';
                document.getElementById('jev-retry-status').style.display = 'none';
            }
        }
        
        // 读取最近执行动作
        if (window.__JEV_PLUGIN_STATUS && window.__JEV_PLUGIN_STATUS.lastAction) {
            const lastAction = window.__JEV_PLUGIN_STATUS.lastAction;
            if (lastAction.name) {
                document.getElementById('jev-last-action').textContent = lastAction.name;
            }
            if (lastAction.ts) {
                const date = new Date(lastAction.ts);
                document.getElementById('jev-last-action-time').textContent = date.toLocaleString();
            }
        }
        
        // 更新上次通信时间
        if (window.__JEV_PLUGIN_STATUS && window.__JEV_PLUGIN_STATUS.lastCommunicationTime) {
            const date = new Date(window.__JEV_PLUGIN_STATUS.lastCommunicationTime);
            const formattedDate = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')} ${String(date.getHours()).padStart(2, '0')}:${String(date.getMinutes()).padStart(2, '0')}:${String(date.getSeconds()).padStart(2, '0')}`;
            document.getElementById('jev-last-communication').textContent = `上次通信时间：${formattedDate}`;
        }
    }
    
    // 监听状态更新
    function setupStatusListener() {
        // 如果window.__JEV_PLUGIN_STATUS已经存在，立即更新显示
        if (window.__JEV_PLUGIN_STATUS) {
            updateStatusDisplay();
        }
        
        // 使用定时器定期检查状态更新
        setInterval(updateStatusDisplay, 1000);
        
        // 监听window对象上的变化（如果插件提供了事件）
        const originalDefineProperty = Object.defineProperty;
        Object.defineProperty = function(obj, prop, descriptor) {
            if (obj === window && prop === '__JEV_PLUGIN_STATUS') {
                const originalGet = descriptor.get;
                const originalSet = descriptor.set;
                
                if (originalSet) {
                    descriptor.set = function(value) {
                        const result = originalSet.apply(this, arguments);
                        updateStatusDisplay();
                        return result;
                    };
                }
            }
            return originalDefineProperty.apply(this, arguments);
        };
    }

    // 通信管理器 - 统一处理与desktopAgent的通信
    const communicationManager = {
        // Agent基础URL
        baseUrl: 'http://localhost:1818',
        
        // 超时设置
        timeout: 5000,
        
        // 发送请求的统一方法
        sendRequest: function(endpoint, options = {}) {
            console.log('请求已发送');
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), this.timeout);
            
            return fetch(`${this.baseUrl}${endpoint}`, {
                ...options,
                headers: {
                    'Content-Type': 'application/json',
                    ...options.headers
                },
                signal: controller.signal
            })
            .finally(() => clearTimeout(timeoutId))
            .then(response => {
                if (response.ok) {
                    console.log('响应成功');
                    return response.json().catch(() => ({}));
                }
                throw new Error(`请求失败，状态码: ${response.status}`);
            });
        },
        
        // Ping Agent方法
        ping: function() {
            return this.sendRequest('/ping', {
                method: 'POST'
            });
        },
        
        // 更新连接状态
        updateConnectionStatus: function(isConnected) {
            if (!window.__JEV_PLUGIN_STATUS) {
                window.__JEV_PLUGIN_STATUS = {};
            }
            window.__JEV_PLUGIN_STATUS.connected = isConnected;
            window.__JEV_PLUGIN_STATUS.lastCommunicationTime = Date.now();
            
            // 如果连接失败，设置重连标志
            if (!isConnected) {
                // 5秒后自动重试
                setTimeout(() => {
                    if (window.__JEV_PLUGIN_STATUS && !window.__JEV_PLUGIN_STATUS.connected) {
                        window.__JEV_PLUGIN_STATUS.reconnecting = true;
                        console.log('连接失败，准备重试...');
                        updateStatusDisplay();
                        this.ping().catch(() => {
                            window.__JEV_PLUGIN_STATUS.reconnecting = false;
                            console.log('重连失败');
                            updateStatusDisplay();
                        });
                    }
                }, 5000);
            } else {
                window.__JEV_PLUGIN_STATUS.reconnecting = false;
            }
            
            updateStatusDisplay();
            
            // 触发自定义事件通知其他组件
            const event = new CustomEvent('jev:connection_status_changed', {
                detail: { connected: isConnected }
            });
            window.dispatchEvent(event);
        },
        
        // 定期检查连接状态
        startConnectionMonitoring: function() {
            // 每分钟检查一次连接
            setInterval(() => {
                this.ping().catch(() => {
                    console.log('连接检查失败');
                    this.updateConnectionStatus(false);
                });
            }, 60000);
        },
        
        // 初始化通信
        init: function() {
            this.startConnectionMonitoring();
        }
    };
    
    // 实现检测连接功能
    function pingAgent() {
        const pingButton = document.getElementById('jev-ping-btn');
        if (pingButton) {
            // 显示加载状态
            const originalText = pingButton.textContent;
            pingButton.textContent = '检测中...';
            pingButton.disabled = true;
            
            // 使用通信管理器发送请求
            communicationManager.ping()
                .then(data => {
                    console.log('检测成功:', data);
                    communicationManager.updateConnectionStatus(true);
                    
                    // 更新最近动作
                    if (!window.__JEV_PLUGIN_STATUS) {
                        window.__JEV_PLUGIN_STATUS = {};
                    }
                    window.__JEV_PLUGIN_STATUS.lastAction = {
                        name: '检测连接',
                        ts: Date.now()
                    };
                    
                    updateStatusDisplay();
                })
                .catch(error => {
                    console.error('检测错误:', error);
                    communicationManager.updateConnectionStatus(false);
                })
                .finally(() => {
                    // 恢复按钮状态
                    pingButton.textContent = originalText;
                    pingButton.disabled = false;
                });
        }
    }
    
    // 实现测试动作功能
    function sendTestAction() {
        const testButton = document.getElementById('jev-test-btn');
        if (testButton) {
            // 显示加载状态
            const originalText = testButton.textContent;
            testButton.textContent = '发送中...';
            testButton.disabled = true;
            
            try {
                // 发送消息
                window.postMessage({
                    type: 'JEV_DO_ACTION',
                    action: 'upload_test'
                }, '*');
                
                // 更新最近动作
                    if (!window.__JEV_PLUGIN_STATUS) {
                        window.__JEV_PLUGIN_STATUS = {};
                    }
                    window.__JEV_PLUGIN_STATUS.lastAction = {
                        name: '测试动作',
                        ts: Date.now()
                    };
                
                updateStatusDisplay();
            } catch (error) {
                console.error('发送测试动作错误:', error);
            } finally {
                // 恢复按钮状态
                testButton.textContent = originalText;
                testButton.disabled = false;
            }
        }
    }
    
    // 设置按钮事件监听器
    function setupButtonListeners() {
        const pingButton = document.getElementById('jev-ping-btn');
        if (pingButton) {
            pingButton.addEventListener('click', pingAgent);
        }
        
        const testButton = document.getElementById('jev-test-btn');
        if (testButton) {
            testButton.addEventListener('click', sendTestAction);
        }
    }

    // 初始化通信系统
    function initCommunication() {
        communicationManager.init();
        
        // 监听来自其他部分的通信请求
        window.addEventListener('jev:send_message', function(event) {
            const { endpoint, data, callback } = event.detail;
            communicationManager.sendRequest(endpoint, {
                method: 'POST',
                body: JSON.stringify(data)
            })
            .then(callback)
            .catch(error => {
                console.error('通信错误:', error);
                if (callback) callback(null, error);
            });
        });
    }

    // 添加折叠功能
    function setupCollapseFunctionality(panel) {
        const collapseBtn = document.getElementById('jev-collapse-btn');
        if (collapseBtn && panel) {
            // 从localStorage恢复折叠状态
            const savedState = localStorage.getItem('jev-panel-collapsed');
            if (savedState === 'true') {
                panel.classList.add('collapsed');
                collapseBtn.classList.add('collapsed');
                collapseBtn.textContent = '展开';
            }
            
            collapseBtn.addEventListener('click', function() {
                panel.classList.toggle('collapsed');
                this.classList.toggle('collapsed');
                
                // 更新按钮文字
                this.textContent = panel.classList.contains('collapsed') ? '展开' : '折叠';
                
                // 保存折叠状态到localStorage
                localStorage.setItem('jev-panel-collapsed', panel.classList.contains('collapsed'));
            });
        }
    }
    
    // 添加拖动功能
    function setupDragFunctionality(panel) {
        const dragHandle = document.getElementById('jev-drag-handle');
        if (dragHandle && panel) {
            let isDragging = false;
            let offsetX, offsetY;
            
            // 从localStorage恢复位置
            const savedX = localStorage.getItem('jev-panel-x');
            const savedY = localStorage.getItem('jev-panel-y');
            
            if (savedX && savedY) {
                panel.style.right = 'auto';
                panel.style.bottom = 'auto';
                panel.style.left = `${savedX}px`;
                panel.style.top = `${savedY}px`;
            }
            
            dragHandle.addEventListener('mousedown', function(e) {
                isDragging = true;
                
                // 计算鼠标相对面板的偏移
                const rect = panel.getBoundingClientRect();
                offsetX = e.clientX - rect.left;
                offsetY = e.clientY - rect.top;
                
                // 添加拖动时的样式
                panel.style.opacity = '0.8';
                dragHandle.style.cursor = 'grabbing';
            });
            
            document.addEventListener('mousemove', function(e) {
                if (!isDragging) return;
                
                // 计算新位置
                const x = e.clientX - offsetX;
                const y = e.clientY - offsetY;
                
                // 更新面板位置
                panel.style.right = 'auto';
                panel.style.bottom = 'auto';
                panel.style.left = `${x}px`;
                panel.style.top = `${y}px`;
            });
            
            document.addEventListener('mouseup', function() {
                if (isDragging) {
                    isDragging = false;
                    
                    // 恢复样式
                    panel.style.opacity = '1';
                    dragHandle.style.cursor = 'grab';
                    
                    // 保存位置到localStorage
                    const rect = panel.getBoundingClientRect();
                    localStorage.setItem('jev-panel-x', rect.left);
                    localStorage.setItem('jev-panel-y', rect.top);
                }
            });
        }
    }
    
    // 初始化函数
    function init() {
        injectTailwindCSS();
        injectCustomStyles();
        const panel = createControlPanel();
        
        // 设置状态监听器
        setupStatusListener();
        
        // 设置按钮事件监听器
        setupButtonListeners();
        
        // 初始化通信
        initCommunication();
        
        // 添加拖动和折叠功能
        setupCollapseFunctionality(panel);
        setupDragFunctionality(panel);
        
        // 初始状态显示
        updateStatusDisplay();
        
        // 初始ping检查连接状态
        setTimeout(() => {
            pingAgent();
        }, 1000);
    }

    // 当页面加载完成后初始化
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();