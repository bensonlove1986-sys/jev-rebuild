// UI Source Hard Lock - Prevent UI chaos by enforcing single source
const UI_SOURCE_DIR = "web-runtime"; // Read-only constant



// ===== SHA1 哈希生成函数 =====
async function generateMessageId(customerId, timestamp, content) {
  const encoder = new TextEncoder();
  const data = encoder.encode(`${customerId}${timestamp}${content}`);
  const hashBuffer = await crypto.subtle.digest('SHA-1', data);
  const hashArray = Array.from(new Uint8Array(hashBuffer));
  return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
}

// ===== HTTP EVENT ENGINE =====
// In-memory message store
const messageStore = new Map();

// Helper function to get messages for a customer
const getMessagesForCustomer = (customerId) => {
  return messageStore.get(customerId) || [];
};

// Helper function to add message to store
const addMessageToStore = (customerId, message) => {
  const messages = getMessagesForCustomer(customerId);
  messages.push(message);
  messageStore.set(customerId, messages);
  return messages;
};

export default {
  async fetch(request, env, ctx) {
    try {
      const url = new URL(request.url);
      const path = url.pathname;
      const upgrade = request.headers.get('Upgrade');

      // ===== ABSOLUTE HARD STOP FOR DAOJIE WS =====
      if (url.pathname === '/ws/daojie' || upgrade === 'websocket') {
        return new Response('WS disabled', {
          status: 410,
          headers: {
            'Connection': 'close',
            'Content-Type': 'text/plain',
            'Access-Control-Allow-Origin': '*'
          }
        });
      }
      // ===== END HARD STOP =====

      // ===== ROOT PATH HANDLING - PRIORITY #1 =====
      if (path === '/' || path === '') {
        // Only allow UI return logic, no API/inbox/status branches
        console.log('[ROOT_PATH] Handling root path, only UI logic allowed');
        
        // Generate a build ID for version fingerprinting
        const UI_BUILD_ID = Date.now().toString();
        
        // Simulate reading from web-runtime/index.html
        const uiContent = `<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/jev-logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="ui-build-id" content="${UI_BUILD_ID}">
    <title>JEV Workspace</title>
    <script type="module" crossorigin src="/assets/index-DfS6ulY8.js"></script>
    <link rel="stylesheet" crossorigin href="/assets/index-DXiG4MDz.css">
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>`;
        
        // Check if UI content exists (it should always exist since it's hardcoded)
        if (!uiContent) {
          console.error('[ROOT_PATH] UI_NOT_FOUND: web-runtime/index.html not found');
          return new Response('UI_NOT_FOUND', {
            status: 500,
            headers: {
              'Content-Type': 'text/plain; charset=utf-8',
              'Access-Control-Allow-Origin': '*'
            }
          });
        }
        
        // Return UI with proper headers
        return new Response(uiContent, {
          status: 200,
          headers: {
            'Content-Type': 'text/html; charset=utf-8',
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
            'Access-Control-Allow-Headers': 'Content-Type',
            'X-UI-Build-Id': UI_BUILD_ID,
            'Cache-Control': 'no-cache, no-store, must-revalidate',
            'Pragma': 'no-cache',
            'Expires': '0'
          }
        });
      }

      // ===== CORS PREFLIGHT =====
      if (request.method === 'OPTIONS') {
        return new Response(null, {
          status: 204,
          headers: {
            'Access-Control-Allow-Origin': 'http://localhost:3000',
            'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
            'Access-Control-Allow-Headers': 'Content-Type',
            'Access-Control-Max-Age': '86400'
          }
        });
      }

      // ===== API STATUS =====
      if (url.pathname === '/api/status') {
        return new Response(
          JSON.stringify({
            status: 'ok',
            ws: 'disabled',
            mode: 'http-event-engine',
            engine: 'active'
          }),
          {
            status: 200,
            headers: {
              'Content-Type': 'application/json',
              'Access-Control-Allow-Origin': 'http://localhost:3000',
              'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
              'Access-Control-Allow-Headers': 'Content-Type'
            }
          }
        );
      }

      // ===== INBOUND DAOJIE WEBHOOK =====
      if (request.method === 'POST' && url.pathname === '/api/inbound/daojie') {
        try {
          // 使用更简单的方式生成 traceId，避免 crypto.randomUUID() 可能的问题
          const traceId = `trace_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
          const startTime = Date.now();
          
          console.log(`[INBOUND][START] traceId=${traceId}`);
          
          // 防御性校验：检查 KV 绑定是否存在
          const KV_BINDING_NAME = 'MESSAGES_KV';
          if (!env[KV_BINDING_NAME]) {
            console.warn(`[INBOUND][WARN][BINDING_MISSING] traceId=${traceId} | binding=${KV_BINDING_NAME} | will use in-memory storage`);
            // 不返回错误，继续使用内存存储
          }
          
          // 1. 读取 raw body 和 content-type
          let rawText = '';
          try {
            rawText = await request.text();
            console.log(`[INBOUND][BODY_READ] traceId=${traceId} | rawText=${rawText.substring(0, 100)}${rawText.length > 100 ? '...' : ''}`);
          } catch (readError) {
            console.error(`[INBOUND][BODY_READ_ERROR] traceId=${traceId} | ${readError.message}`);
            return new Response(
              JSON.stringify({ success: true, message_id: `msg_${Date.now()}_read_error`, trace_id: traceId }),
              {
                status: 200,
                headers: {
                  'Content-Type': 'application/json',
                  'Access-Control-Allow-Origin': '*',
                  'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                  'Access-Control-Allow-Headers': 'Content-Type',
                  'X-Trace-Id': traceId
                }
              }
            );
          }
          
          const contentType = request.headers.get('content-type') || '';
          console.log(`[INBOUND][CONTENT_TYPE] traceId=${traceId} | contentType=${contentType}`);
          
          let body = {};
          let bodyKeys = [];
          
          // 3. 解析 body，兼容不同格式
          if (contentType.includes('application/json') && rawText.trim() !== '') {
            try {
              body = JSON.parse(rawText);
              bodyKeys = Object.keys(body);
              console.log(`[INBOUND][PARSE_SUCCESS] traceId=${traceId} | bodyKeys=${bodyKeys.join(',')}`);
            } catch (parseError) {
              console.error(`[INBOUND][PARSE_ERROR] traceId=${traceId} | ${parseError.message} | rawText=${rawText.substring(0, 100)}${rawText.length > 100 ? '...' : ''}`);
              // 解析失败仍返回 200，避免平台重试风暴
              return new Response(
                JSON.stringify({ success: true, message_id: `msg_${Date.now()}_parse_error`, trace_id: traceId }),
                {
                  status: 200,
                  headers: {
                    'Content-Type': 'application/json',
                    'Access-Control-Allow-Origin': '*',
                    'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                    'Access-Control-Allow-Headers': 'Content-Type',
                    'X-Trace-Id': traceId
                  }
                }
              );
            }
          }
          
          // 4. 兼容外部 webhook 常见字段映射 - 带强校验和自动填充
          
          // 确保 contact 对象存在
          if (!body.contact) {
            body.contact = {
              id: body.customer_id || body.customerId || body.contact_id || body.platform_conversation_id || 'unknown'
            };
          }
          
          // 确保 message 对象存在
          if (!body.message) {
            body.message = {
              body: body.text || body.body || '',
              channel: body.channel || 'unknown'
            };
          } else {
            // 确保 message.body 存在
            if (!body.message.body) {
              body.message.body = body.text || body.body || '';
            }
            // 确保 message.channel 存在
            if (!body.message.channel) {
              body.message.channel = body.channel || 'unknown';
            }
          }
          
          // 归一化用户ID - 使用稳定的customer_id来源
          const { getDisplayName, normalizeUserId } = await import('./utils/user.js');
          
          // 使用稳定ID，按优先级：contact.id > sender_id > phone > username
          const stableCustomerId = 
            body.contact?.id || 
            body.sender_id || 
            body.phone || 
            body.username;
          
          if (!stableCustomerId) {
            throw new Error('[DAOJIE] missing stable customer id');
          }
          
          // 使用统一的normalizeUserId函数进行归一化，确保与inbox pull保持一致
          const customerId = normalizeUserId(stableCustomerId);
          
          // 提取 text - 确保只返回字符串
          let text = '';
          if (typeof body.text === 'string') {
            text = body.text;
          } else if (typeof body.body === 'string') {
            text = body.body;
          } else if (body.message) {
            if (typeof body.message === 'string') {
              text = body.message;
            } else if (typeof body.message.body === 'string') {
              text = body.message.body;
            } else if (typeof body.message.text === 'string') {
              text = body.message.text;
            }
          } else if (body.payload && typeof body.payload.text === 'string') {
            text = body.payload.text;
          }
          text = text.trim();
          
          // 提取 source - 确保只返回字符串，自动填充缺失值
          let source = body.source;
          if (!source || typeof source !== 'string') {
            source = 'daojie';
            console.log(`[INBOUND][SOURCE_AUTOFILL] traceId=${traceId} | source=daojie`);
          }
          
          // 确保 source 已存在于 body
          body.source = source;
          
          // 提取 timestamp
          const timestamp = body.timestamp || 
                           body.message?.created_at || 
                           Date.now();
          
          // 确保 timestamp 已存在于 body
          body.timestamp = timestamp;
          
          // 5. 记录校验结果
          console.log(`[INBOUND][VALIDATED] traceId=${traceId} | contactId=${customerId} | textLen=${text.trim().length} | source=${source} | ts=${timestamp}`);
          
          // 记录用户ID归一化
          console.log(`[USER][NORMALIZED] traceId=${traceId} | normalized=${customerId}`);
          
          // 6. 处理空消息（trim后长度=0）
          if (!text.trim()) {
            console.log(`[INBOUND][DROP_EMPTY] traceId=${traceId} | customerId=${customerId} | rawKeys=${bodyKeys.join(',')}`);
            // 空消息不写入 KV/inbox，但仍返回 200
            return new Response(
              JSON.stringify({ success: true, message_id: `msg_${Date.now()}_empty`, trace_id: traceId }),
              {
                status: 200,
                headers: {
                  'Content-Type': 'application/json',
                  'Access-Control-Allow-Origin': 'http://localhost:3000',
                  'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                  'Access-Control-Allow-Headers': 'Content-Type',
                  'X-Trace-Id': traceId
                }
              }
            );
          }
          
          // 7. 提取真实用户名
          const { isLikelyTechId, firstNonEmpty } = await import('./utils/user.js');
          const displayNameCandidate = firstNonEmpty(
            body.contact?.name,
            body.contact?.displayName,
            body.contact?.username,
            body.customer_name,
            body.sender_name
          );
          
          // 8. 引入硬索引机制
          const ts = Date.now();
          const messageId = 
            body.message_id || 
            body.platform_message_id || 
            body.platform_conversation_id || 
            crypto.randomUUID();
          
          // 防御性校验：确保messageId存在
          if (!messageId) {
            console.error('[INBOUND][FATAL][NO_MESSAGE_ID]', body);
            return new Response('Invalid messageId', { status: 400 });
          }
          
          const msgKey = `inbox:msg:${customerId}:${ts}:${messageId}`;
          
          // 9. Normalize message structure for KV storage - use stable customerId
          const message = {
            id: messageId,
            userId: customerId,
            customer_id: customerId,
            text: text, // ✅ 补齐顶层text字段
            content: text,
            type: 'inbound', // ✅ 补齐顶层type字段
            sender_name: body.sender_name, // ✅ 补齐顶层sender_name字段
            timestamp: ts,
            source: source,
            trace_id: traceId,
            displayName: getDisplayName(body.contact, customerId),
            contact: {
              id: customerId,
              displayName: getDisplayName(body.contact, customerId),
              sender_name: body.sender_name,
              username: body.contact?.username,
              company_name: body.company_name
            }
          };

          // 10. Store message in KV (only if KV binding is available)
          let stored = false;
          if (env[KV_BINDING_NAME]) {
            try {
              // 写入消息
              await env[KV_BINDING_NAME].put(msgKey, JSON.stringify(message));
              stored = true;
              
              // 写入用户信息（profileKey）
              const profileKey = `profile:${customerId}`;
              const userKey = `user:${customerId}`;
              
              // 如果 candidate 存在且不是 techId，则写入 profile
              if (displayNameCandidate && !isLikelyTechId(displayNameCandidate)) {
                const profile = {
                  customer_id: customerId,
                  displayName: displayNameCandidate,
                  username: body.contact?.username || '',
                  source: source,
                  updatedAt: ts
                };
                await env[KV_BINDING_NAME].put(profileKey, JSON.stringify(profile));
              }
              
              // 写入用户信息（兼容旧版本）
              await env[KV_BINDING_NAME].put(userKey, JSON.stringify({
                userId: customerId,
                displayName: displayNameCandidate || getDisplayName(body.contact, customerId),
                source: source,
                updatedAt: ts
              }));
              
              // 成功写入日志
              console.log('[INBOUND][WRITE_OK]', {
                messageId,
                customer_id: customerId,
                textPreview: body.text?.slice(0, 30)
              });
              
              // 11. Update INBOX_INDEX (按用户ID分类)
              const indexKey = `inbox_index:${customerId}`;
              const indexRaw = await env[KV_BINDING_NAME].get(indexKey);
              const index = indexRaw ? JSON.parse(indexRaw) : [];
              index.push({ ts, key: msgKey });
              await env[KV_BINDING_NAME].put(indexKey, JSON.stringify(index));
              
              // 12. Update global inbox index
              const globalIndexKey = "INBOX_INDEX";
              const globalIndexRaw = await env[KV_BINDING_NAME].get(globalIndexKey);
              const globalIndex = globalIndexRaw ? JSON.parse(globalIndexRaw) : [];
              globalIndex.push({ ts, key: msgKey, userId: customerId });
              // 只保留最近1000条记录
              if (globalIndex.length > 1000) {
                globalIndex.splice(0, globalIndex.length - 1000);
              }
              await env[KV_BINDING_NAME].put(globalIndexKey, JSON.stringify(globalIndex));
              
              console.log(`[INBOX][INDEX_WRITE] traceId=${traceId} | ts=${ts} | userId=${customerId} | key=${msgKey} | indexSize=${index.length}`);
            } catch (kvError) {
              console.error(`[INBOUND][KV_ERROR] traceId=${traceId} | ${kvError.message}`);
            }
          } else {
            console.log(`[INBOUND][KV_SKIPPED] traceId=${traceId} | ${KV_BINDING_NAME} not available`);
          }
          
          // 11. Store in memory for faster access (保持兼容)
          addMessageToStore(customerId, {
            ...message,
            type: 'inbound', // ✅ 保持一致的type
            text: text
          });
          
          // 添加DAOJIE专属日志
          console.log('[TRACE][DAOJIE_INBOUND_STORED]', {
            customerId,
            text,
            type: 'inbound',
            stored
          });

          const totalTime = performance.now() - startTime;
          // Return success response
          return new Response(
            JSON.stringify({ success: true, message_id: messageId, trace_id: traceId }),
            {
              status: 200,
              headers: {
                'Content-Type': 'application/json',
                'Access-Control-Allow-Origin': 'http://localhost:3000',
                'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                'Access-Control-Allow-Headers': 'Content-Type',
                'X-Trace-Id': traceId
              }
            }
          );
        } catch (error) {
          const traceId = `trace_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
          console.error(`[INBOUND][FATAL] traceId=${traceId} | error=${error.message} | stack=${error.stack || 'no stack'}`);
          return new Response(
            JSON.stringify({ success: false, error: error.message, trace_id: traceId }),
            {
              status: 400,
              headers: {
                'Content-Type': 'application/json',
                'Access-Control-Allow-Origin': '*',
                'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                'Access-Control-Allow-Headers': 'Content-Type',
                'X-Trace-Id': traceId
              }
            }
          );
        }
      }

      // ===== MESSAGE POLLING ENDPOINT =====
      if (request.method === 'GET' && url.pathname === '/api/messages') {
        try {
          const customer_id = url.searchParams.get('customer_id');
          if (!customer_id) {
            return new Response(
              JSON.stringify({ error: 'customer_id is required' }),
              {
                status: 400,
                headers: {
                  'Content-Type': 'application/json',
                  'Access-Control-Allow-Origin': 'http://localhost:3000'
                }
              }
            );
          }

          const messages = getMessagesForCustomer(customer_id);
          console.log(`[HTTP EVENT] Polled messages for ${customer_id}: ${messages.length}`);

          return new Response(
            JSON.stringify(messages),
            {
              status: 200,
              headers: {
                'Content-Type': 'application/json',
                'Access-Control-Allow-Origin': 'http://localhost:3000',
                'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                'Access-Control-Allow-Headers': 'Content-Type'
              }
            }
          );
        } catch (error) {
          console.error(`[HTTP EVENT ERROR] Polling: ${error.message}`);
          return new Response(
            JSON.stringify({ error: 'Polling failed' }),
            {
              status: 500,
              headers: {
                'Content-Type': 'application/json',
                'Access-Control-Allow-Origin': 'http://localhost:3000'
              }
            }
          );
        }
      }

      // ===== SEND MESSAGE ENDPOINT =====
      if (request.method === 'POST' && url.pathname === '/api/send') {
        try {
          const traceId = crypto.randomUUID();
          const body = await request.json();
          const { customer_id, text } = body;
          
          if (!customer_id || !text) {
            return new Response(
              JSON.stringify({ ok: false, error: 'customer_id and text are required' }),
              {
                status: 400,
                headers: {
                  'Content-Type': 'application/json',
                  'Access-Control-Allow-Origin': 'http://localhost:3000',
                  'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                  'Access-Control-Allow-Headers': 'Content-Type',
                  'X-Trace-Id': traceId
                }
              }
            );
          }

          // Create message object
          const message = {
            id: `msg_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,
            customer_id,
            text,
            type: 'agent',
            timestamp: new Date().toISOString(),
            source: 'operator',
            status: 'sent'
          };

          // Store the message
          addMessageToStore(customer_id, message);
          
          // 记录符合要求的Outbound发送日志
          console.log(`[OUTBOUND][SEND] traceId=${traceId} customerId=${customer_id} textLen=${text.length} target=external_platform`);
          
          // 模拟外部平台发送逻辑（实际项目中应替换为真实API调用）
          let sendResult = 'success';
          try {
            // 这里应该是真实的外部平台API调用
            // 例如：await fetch('https://external-platform.com/send', { ... });
            console.log(`[OUTBOUND] ${traceId} | Simulating external send to ${customer_id}`);
            sendResult = 'success';
          } catch (error) {
            console.error(`[OUTBOUND] ${traceId} | External send failed: ${error.message}`);
            sendResult = 'error';
          }
          
          // 记录发送结果日志
          console.log(`[OUTBOUND][RESULT] traceId=${traceId} status=${sendResult}`);

          // Return success response
          return new Response(
            JSON.stringify({ ok: true, message }),
            {
              status: 200,
              headers: {
                'Content-Type': 'application/json',
                'Access-Control-Allow-Origin': 'http://localhost:3000',
                'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                'Access-Control-Allow-Headers': 'Content-Type',
                'X-Trace-Id': traceId
              }
            }
          );
        } catch (error) {
          const traceId = crypto.randomUUID();
          console.error(`[OUTBOUND] ERROR | ${traceId} | ${error.message}`);
          return new Response(
            JSON.stringify({ ok: false, error: 'Send failed' }),
            {
              status: 500,
              headers: {
                'Content-Type': 'application/json',
                'Access-Control-Allow-Origin': 'http://localhost:3000',
                'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                'Access-Control-Allow-Headers': 'Content-Type',
                'X-Trace-Id': traceId
              }
            }
          );
        }
      }

      // ===== MESSAGE SEND ALIAS FOR COMPATIBILITY =====
      if (request.method === 'POST' && url.pathname === '/api/message/send') {
        try {
          const traceId = crypto.randomUUID();
          const body = await request.json();
          const { customer_id, text, source } = body;
          
          // Create message object
          const message = {
            id: `msg_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,
            customer_id,
            text,
            type: 'agent',
            timestamp: new Date().toISOString(),
            source: source || 'operator',
            status: 'sent'
          };

          // Store the message
          addMessageToStore(customer_id, message);
          
          // 记录符合要求的Outbound发送日志
          console.log(`[OUTBOUND][SEND] traceId=${traceId} customerId=${customer_id} textLen=${text.length} target=external_platform`);
          
          // 模拟外部平台发送逻辑（实际项目中应替换为真实API调用）
          let sendResult = 'success';
          try {
            // 这里应该是真实的外部平台API调用
            // 例如：await fetch('https://external-platform.com/send', { ... });
            console.log(`[OUTBOUND] ${traceId} | Simulating external send to ${customer_id}`);
            sendResult = 'success';
          } catch (error) {
            console.error(`[OUTBOUND] ${traceId} | External send failed: ${error.message}`);
            sendResult = 'error';
          }
          
          // 记录发送结果日志
          console.log(`[OUTBOUND][RESULT] traceId=${traceId} status=${sendResult}`);
          
          // Return success response
          return new Response(
            JSON.stringify({ ok: true }),
            {
              status: 200,
              headers: {
                'Content-Type': 'application/json',
                'Access-Control-Allow-Origin': 'http://localhost:3000',
                'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                'Access-Control-Allow-Headers': 'Content-Type',
                'X-Trace-Id': traceId
              }
            }
          );
        } catch (error) {
          const traceId = crypto.randomUUID();
          console.error(`[OUTBOUND] ERROR | ${traceId} | alias=true | ${error.message}`);
          return new Response(
            JSON.stringify({ ok: false, error: 'Invalid request' }),
            {
              status: 400,
              headers: {
                'Content-Type': 'application/json',
                'Access-Control-Allow-Origin': 'http://localhost:3000',
                'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                'Access-Control-Allow-Headers': 'Content-Type',
                'X-Trace-Id': traceId
              }
            }
          );
        }
      }

      // ===== INBOX PULL ENDPOINT =====
      if (request.method === 'GET' && url.pathname === '/api/inbox/pull') {
        // 第一步：锁定 500 发生点，最外层加 try/catch
        try {
          // 重点排查三类必炸点
          
          // 1️⃣ 强制使用安全的 since 值
          const sinceParam = url.searchParams.get('since');
          const sinceSafe = Number.isFinite(+sinceParam) ? +sinceParam : 0;
          const traceId = `trace_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`; // 使用更安全的 traceId 生成方式
          const startTime = Date.now();
          
          // 记录拉取开始日志
          console.log(`[INBOX][PULL_START] traceId=${traceId} | sinceSafe=${sinceSafe}`);
          
          // 归一化用户ID
          const { normalizeUserId } = await import('./utils/user.js');
          
          // 获取拉取参数 - 支持 customerId 或 customer_id
          const customerIdParam = url.searchParams.get('customerId') || url.searchParams.get('customer_id');
          // 生成 normalizedCustomerId - 严格按要求：toLowerCase().trim()
          const normalizedCustomerId = customerIdParam ? customerIdParam.toLowerCase().trim() : null;
          // 确定 requestedCustomerId
          const requestedCustomerId = normalizedCustomerId;
          
          // 统一 KV 绑定名称
          const KV_BINDING_NAME = 'MESSAGES_KV';
          
          // 2️⃣ KV 绑定是否为空
          if (!env[KV_BINDING_NAME]) {
            console.error(`[INBOX][FATAL][BINDING_MISSING] traceId=${traceId} | binding=${KV_BINDING_NAME}`);
            return new Response(
              JSON.stringify({
                messages: [],
                cursor: 0,
                hasMore: false,
                error: "BINDING_MISSING"
              }),
              {
                status: 200,
                headers: {
                  'Content-Type': 'application/json',
                  'Access-Control-Allow-Origin': 'http://localhost:3000',
                  'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                  'Access-Control-Allow-Headers': 'Content-Type',
                  'X-Trace-Id': traceId
                }
              }
            );
          }
          
          let messages = [];
          let cursorAfter = sinceSafe;
          let indexSize = 0;
          let items = [];
          
          // 1. 确定要读取的索引键
          console.log(`[INBOX][INDEX_READ] traceId=${traceId} | action=start`);
          
          // 2. 根据是否有customerIdParam选择不同的索引
          if (normalizedCustomerId) {
            // 按用户ID读取索引
            const indexKey = `inbox_index:${normalizedCustomerId}`;
            const indexRaw = await env[KV_BINDING_NAME].get(indexKey);
            if (indexRaw) {
              let parsedIndex = [];
              // 3️⃣ JSON.parse 未保护
              try {
                parsedIndex = JSON.parse(indexRaw);
              } catch (parseError) {
                console.error(`[INBOX][JSON_PARSE_ERROR] traceId=${traceId} | error=${parseError.message}`);
                return new Response(
                  JSON.stringify({
                    messages: [],
                    cursor: sinceSafe,
                    hasMore: false,
                    error: "JSON_PARSE_ERROR"
                  }),
                  {
                    status: 200,
                    headers: {
                      'Content-Type': 'application/json',
                      'Access-Control-Allow-Origin': 'http://localhost:3000',
                      'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                      'Access-Control-Allow-Headers': 'Content-Type',
                      'X-Trace-Id': traceId
                    }
                  }
                );
              }
              items = parsedIndex.filter(i => i.ts > sinceSafe);
              indexSize = items.length;
              console.log(`[INBOX][INDEX_READ] traceId=${traceId} | userId=${normalizedCustomerId} | indexSize=${indexSize}`);
            } else {
              console.log(`[INBOX][INDEX_READ] traceId=${traceId} | userId=${normalizedCustomerId} | indexSize=0`);
            }
          } else {
            // 读取全局索引
            const globalIndexKey = "INBOX_INDEX";
            const globalIndexRaw = await env[KV_BINDING_NAME].get(globalIndexKey);
            if (globalIndexRaw) {
              let parsedGlobalIndex = [];
              // 3️⃣ JSON.parse 未保护
              try {
                parsedGlobalIndex = JSON.parse(globalIndexRaw);
              } catch (parseError) {
                console.error(`[INBOX][JSON_PARSE_ERROR] traceId=${traceId} | error=${parseError.message}`);
                return new Response(
                  JSON.stringify({
                    messages: [],
                    cursor: sinceSafe,
                    hasMore: false,
                    error: "JSON_PARSE_ERROR"
                  }),
                  {
                    status: 200,
                    headers: {
                      'Content-Type': 'application/json',
                      'Access-Control-Allow-Origin': 'http://localhost:3000',
                      'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                      'Access-Control-Allow-Headers': 'Content-Type',
                      'X-Trace-Id': traceId
                    }
                  }
                );
              }
              items = parsedGlobalIndex.filter(i => i.ts > sinceSafe);
              indexSize = items.length;
              console.log(`[INBOX][INDEX_READ] traceId=${traceId} | globalIndexSize=${indexSize}`);
            } else {
              console.log(`[INBOX][INDEX_READ] traceId=${traceId} | globalIndexSize=0`);
            }
          }
          
          // 3. Filter and sort items
          if (items.length === 0) {
            // 兜底规则：如果没有匹配的items，忽略since，尝试获取最新的记录
            if (normalizedCustomerId) {
              const indexKey = `inbox_index:${normalizedCustomerId}`;
              const indexRaw = await env[KV_BINDING_NAME].get(indexKey);
              if (indexRaw) {
                let fullIndex = [];
                try {
                  fullIndex = JSON.parse(indexRaw);
                } catch (parseError) {
                  console.error(`[INBOX][JSON_PARSE_ERROR] traceId=${traceId} | error=${parseError.message}`);
                }
                items = fullIndex.slice(-20);
                indexSize = fullIndex.length;
              }
            } else {
              const globalIndexKey = "INBOX_INDEX";
              const globalIndexRaw = await env[KV_BINDING_NAME].get(globalIndexKey);
              if (globalIndexRaw) {
                let fullIndex = [];
                try {
                  fullIndex = JSON.parse(globalIndexRaw);
                } catch (parseError) {
                  console.error(`[INBOX][JSON_PARSE_ERROR] traceId=${traceId} | error=${parseError.message}`);
                }
                items = fullIndex.slice(-20);
                indexSize = fullIndex.length;
              }
            }
          } else {
            // 按时间排序，取最近20条
            items = items
              .sort((a, b) => a.ts - b.ts)
              .slice(0, 20);
          }
          
          // 4. Fetch messages
          console.log(`[INBOX][DATA_READ] traceId=${traceId} | items=${items.length}`);
          messages = [];
          for (const item of items) {
            const raw = await env[KV_BINDING_NAME].get(item.key);
            if (raw) {
              let msg = null;
              try {
                msg = JSON.parse(raw);
              } catch (parseError) {
                console.error(`[INBOX][JSON_PARSE_ERROR] traceId=${traceId} | itemKey=${item.key} | error=${parseError.message}`);
                continue; // 跳过解析失败的消息
              }
              
              // 确保消息有userId字段，兼容旧数据
              if (!msg.userId && msg.customerId) {
                msg.userId = normalizeUserId(msg.customerId);
                // 归一化messageId
                msg.id = msg.id || item.key.split(':')[3];
                // 兼容displayName
                msg.displayName = msg.displayName || 'unknown';
              }
              
              // 确保消息有customer_id字段，并且与userId一致
              msg.customer_id = msg.userId || msg.customerId || '';
              
              // 确保消息有contact字段
              if (!msg.contact) {
                msg.contact = {
                  id: msg.userId || msg.customer_id || '',
                  displayName: msg.displayName || 'unknown'
                };
              }
              
              // 为每条消息补齐 contact.displayName
              if (!msg.contact.displayName) {
                const profileKey = `profile:${msg.userId || msg.customer_id}`;
                const profileRaw = await env[KV_BINDING_NAME].get(profileKey);
                if (profileRaw) {
                  let profile = null;
                  try {
                    profile = JSON.parse(profileRaw);
                  } catch (parseError) {
                    console.error(`[INBOX][JSON_PARSE_ERROR] traceId=${traceId} | profileKey=${profileKey} | error=${parseError.message}`);
                  }
                  if (profile && profile.displayName) {
                    msg.contact.displayName = profile.displayName;
                    msg.displayName = profile.displayName;
                  }
                } else {
                  // 回退到用户信息
                  const userKey = `user:${msg.userId || msg.customer_id}`;
                  const userRaw = await env[KV_BINDING_NAME].get(userKey);
                  if (userRaw) {
                    let user = null;
                    try {
                      user = JSON.parse(userRaw);
                    } catch (parseError) {
                      console.error(`[INBOX][JSON_PARSE_ERROR] traceId=${traceId} | userKey=${userKey} | error=${parseError.message}`);
                    }
                    if (user && user.displayName) {
                      msg.contact.displayName = user.displayName;
                      msg.displayName = user.displayName;
                    }
                  }
                }
              }
              
              // 如果指定了customer_id，只返回该客户的消息
              if (!normalizedCustomerId || msg.userId === normalizedCustomerId) {
                messages.push(msg);
                console.log(`[INBOX][MATCH] traceId=${traceId} | userId=${msg.userId} | displayName=${msg.contact.displayName}`);
              }
            }
          }
          
          // 5. Determine cursorAfter
          cursorAfter = items.length ? items[items.length - 1].ts : sinceSafe;
          
          // 记录索引读取完成日志
          console.log(`[INBOX][INDEX_READ] traceId=${traceId} | indexSize=${indexSize} | sinceSafe=${sinceSafe} | returned=${messages.length} | cursorAfter=${cursorAfter}`);
          
          // 添加非人类消息过滤 - 严格遵循JEV消息分级协议
          const isHumanMessage = (msg) => {
            if (!msg) return false;
            
            // 明确标记
            if (msg.sender_type && msg.sender_type !== 'human') return false;
            
            // 系统来源
            if (['system', 'health_check', 'kv_probe', 'bootstrap'].includes(msg.source)) {
              return false;
            }
            
            // 系统关键字
            const t = (msg.text || '').toUpperCase();
            if (
              t.includes('KV FINAL CHECK') || 
              t.includes('HEALTH CHECK') || 
              t.includes('SYSTEM CHECK')
            ) {
              return false;
            }
            
            return true;
          };
          
          // 过滤非人类消息
          const humanMessages = messages.filter(msg => {
            if (isHumanMessage(msg)) {
              return true;
            } else {
              console.log('[DROP][NON_HUMAN_MESSAGE]', {
                id: msg.id,
                source: msg.source,
                text: msg.text,
                sender_type: msg.sender_type
              });
              return false;
            }
          });
          
          // 添加额外的customer_id过滤保障 - 确保只返回请求的customerId
          const finalMessages = normalizedCustomerId 
            ? humanMessages.filter(msg => {
                // 确保msg.customer_id存在且与requestedCustomerId匹配
                msg.customer_id = msg.customer_id || '';
                const isMatch = msg.customer_id === requestedCustomerId;
                if (!isMatch) {
                  console.log('[DROP][CUSTOMER_ID_MISMATCH]', {
                    requested: requestedCustomerId,
                    actual: msg.customer_id,
                    id: msg.id,
                    text: msg.text
                  });
                }
                return isMatch;
              })
            : humanMessages;
          
          // 计算返回的唯一customerIds - 使用finalMessages
          const uniqueCustomerIds = [...new Set(finalMessages.map(m => m.customer_id))];
          const returnedCustomerIds = uniqueCustomerIds;
          
          // 添加强校验日志
          console.log('[INBOX][FILTER]', {
            requestedCustomerId: normalizedCustomerId || 'none',
            returnedCustomerIds
          });
          
          // 添加最终过滤结果日志
          console.log('[INBOX][FILTER_RESULT]', {
            requestedCustomerId,
            returnedCustomerIds,
            count: finalMessages.length
          });
          
          // 强制验证：只允许返回一个customerId
          if (requestedCustomerId && uniqueCustomerIds.length > 1) {
            throw new Error("INBOX_MULTI_CUSTOMER_RETURN_FORBIDDEN");
          }
          
          // 记录拉取完成日志
          console.log(`[INBOX][PULL_OK] traceId=${traceId} | messages=${finalMessages.length} | cursor=${cursorAfter} | hasMore=false`);
          
          // 断点B：/api/inbox/pull返回内容
          console.log('[TRACE][INBOX_PULL_RESPONSE]', {
            count: finalMessages.length,
            customerIds: uniqueCustomerIds,
            sampleMessage: finalMessages.length > 0 ? finalMessages[0] : null
          });
          
          // 6. Return response - 使用finalMessages
          return new Response(
            JSON.stringify({
              messages: finalMessages,
              cursor: cursorAfter,
              hasMore: false
            }),
            {
              status: 200,
              headers: {
                'Content-Type': 'application/json',
                'Access-Control-Allow-Origin': 'http://localhost:3000',
                'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                'Access-Control-Allow-Headers': 'Content-Type',
                'X-Trace-Id': traceId
              }
            }
          );
        } catch (error) {
          // 强制使用 trace_前缀，避免 crypto.randomUUID() 可能的问题
          const traceId = `trace_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
          // 按照要求的格式输出日志
          console.error(`[INBOX][FATAL] traceId=${traceId} | error=${error.message} | stack=${error.stack || 'no stack'}`);
          return new Response(
            JSON.stringify({
              messages: [],
              cursor: 0,
              hasMore: false,
              error: 'INBOX_FATAL_BYPASS'
            }),
            {
              status: 200, // 强制返回200，避免500直接把UI打死
              headers: {
                'Content-Type': 'application/json',
                'Access-Control-Allow-Origin': 'http://localhost:3000',
                'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                'Access-Control-Allow-Headers': 'Content-Type',
                'X-Trace-Id': traceId
              }
            }
          );
        }
      }

      // ===== TRANSLATION API =====
      if (request.method === 'POST' && url.pathname === '/api/translate/business') {
        try {
          const traceId = crypto.randomUUID();
          const startTime = performance.now();
          
          // Parse request body
          const body = await request.json();
          const { text, sourceLang = 'en', targetLang = 'zh' } = body;
          
          // Validate required fields
          if (!text) {
            return new Response(
              JSON.stringify({ ok: false, error: 'Text is required' }),
              {
                status: 400,
                headers: {
                  'Content-Type': 'application/json',
                  'Access-Control-Allow-Origin': 'http://localhost:3000',
                  'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                  'Access-Control-Allow-Headers': 'Content-Type'
                }
              }
            );
          }
          
          let translatedText;
          let engine = 'deepseek';
          let success = true;
          
          // If source and target languages are the same, return original text
          if (sourceLang === targetLang) {
            translatedText = text;
            engine = 'same-lang';
          } else {
            // DeepSeek API call
            try {
              const deepseekResp = await fetch(
                "https://api.deepseek.com/v1/chat/completions",
                {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/json",
                    "Authorization": `Bearer ${env.DEEPSEEK_API_KEY}`
                  },
                  body: JSON.stringify({
                    model: "deepseek-chat",
                    messages: [
                      {
                        role: "system",
                        content: "You are a professional business translator. Translate the text accurately."
                      },
                      {
                        role: "user",
                        content: `Translate from ${sourceLang} to ${targetLang}: ${text}`
                      }
                    ],
                    temperature: 0.1
                  })
                }
              );
              
              if (!deepseekResp.ok) {
                throw new Error(`DeepSeek API returned non-200 status: ${deepseekResp.status}`);
              }
              
              const deepseekData = await deepseekResp.json();
              translatedText = deepseekData?.choices?.[0]?.message?.content?.trim() || text;
              
              if (!translatedText || translatedText === text) {
                // If translation failed to produce different result, use fallback
                translatedText = text;
                engine = 'fallback';
              }
            } catch (error) {
              // Fallback to original text on any error
              console.error(`[TRANSLATE] ${traceId} | DeepSeek API error: ${error.message}`);
              translatedText = text;
              engine = 'fallback';
              success = false;
            }
          }
          
          // Prepare response
          const responseBody = {
            ok: true,
            translatedText,
            sourceLang,
            targetLang,
            engine
          };
          
          // Log structured translation request
          const textLength = text.length;
          const totalTime = performance.now() - startTime;
          console.log(`[TRANSLATE] ${traceId} | api=translate | sourceLang=${sourceLang} | targetLang=${targetLang} | textLength=${textLength} | success=${success} | engine=${engine} | time=${totalTime.toFixed(2)}ms`);
          
          return new Response(
            JSON.stringify(responseBody),
            {
              status: 200,
              headers: {
                'Content-Type': 'application/json',
                'Access-Control-Allow-Origin': 'http://localhost:3000',
                'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                'Access-Control-Allow-Headers': 'Content-Type',
                'X-Trace-Id': traceId
              }
            }
          );
        } catch (error) {
          const traceId = crypto.randomUUID();
          console.error(`[TRANSLATE] ${traceId} | api=translate | success=false | error=${error.message}`);
          
          // Return error response
          return new Response(
            JSON.stringify({ ok: false, error: 'Translation failed', details: error.message }),
            {
              status: 500,
              headers: {
                'Content-Type': 'application/json',
                'Access-Control-Allow-Origin': 'http://localhost:3000',
                'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
                'Access-Control-Allow-Headers': 'Content-Type',
                'X-Trace-Id': traceId
              }
            }
          );
        }
      }
      
      // ===== UI ROUTING LOCKED - ONLY web-runtime ALLOWED =====
      // Generate a build ID for version fingerprinting
      const UI_BUILD_ID = Date.now().toString(); // Use timestamp as build ID
      
      // Explicitly block redundant UI paths
      const BLOCKED_UI_PATHS = [
        '/ui/', '/ui/*',
        '/chat', '/chat*',
        '/static/', '/static/*',
        '/index.html'
      ];

      // Check if the path should be blocked
      const shouldBlockPath = BLOCKED_UI_PATHS.some(blockedPath => {
        if (blockedPath.endsWith('/*')) {
          const basePath = blockedPath.slice(0, -2);
          return path === basePath || path.startsWith(basePath + '/');
        }
        return path === blockedPath;
      });

      // Block all redundant UI paths
      if (shouldBlockPath) {
        return new Response('UI Path Forbidden - Only web-runtime UI allowed', {
          status: 404,
          headers: {
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
            'Access-Control-Allow-Headers': 'Content-Type'
          }
        });
      }

      // Serve __ui_runtime__.json endpoint for verification - ENFORCING UI_SOURCE_DIR
      if (path === '/__ui_runtime__.json') {
        return new Response(JSON.stringify({
          "ui_name": "JEV ChatUI",
          "ui_version": "v4",
          "source_dir": UI_SOURCE_DIR,
          "local_verify_port": 3000,
          "verified": true,
          "build_id": UI_BUILD_ID
        }), {
          status: 200,
          headers: {
            'Content-Type': 'application/json',
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
            'Access-Control-Allow-Headers': 'Content-Type',
            'X-UI-Build-Id': UI_BUILD_ID
          }
        });
      }

      // Serve CSS file from web-runtime/assets with proper caching
      if (path === '/assets/index-DXiG4MDz.css') {
        return new Response(`.ant-layout{min-height:100vh}.ant-layout-header{background:#fff;padding:0}.ant-layout-content{background:#f0f2f5}.chat-panel{display:flex;flex-direction:column;height:100%}.chat-header{padding:12px 16px;border-bottom:1px solid #f0f0f0}.chat-messages{flex:1;overflow-y:auto;padding:16px}.chat-input{padding:16px;border-top:1px solid #f0f0f0}`, {
          status: 200,
          headers: {
            'Content-Type': 'text/css',
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
            'Access-Control-Allow-Headers': 'Content-Type',
            'X-UI-Build-Id': UI_BUILD_ID,
            // Long-term caching for static assets
            'Cache-Control': 'public, max-age=31536000, immutable'
          }
        });
      }

      // Serve JS file from web-runtime/assets with proper caching
      if (path === '/assets/index-DfS6ulY8.js') {
        return new Response(`console.log('JEV ChatUI loaded successfully!');`, {
          status: 200,
          headers: {
            'Content-Type': 'application/javascript',
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
            'Access-Control-Allow-Headers': 'Content-Type',
            'X-UI-Build-Id': UI_BUILD_ID,
            // Long-term caching for static assets
            'Cache-Control': 'public, max-age=31536000, immutable'
          }
        });
      }

      // Serve logo SVG from web-runtime with proper caching
      if (path === '/jev-logo.svg') {
        return new Response(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90" fill="#1890ff">JEV</text></svg>`, {
          status: 200,
          headers: {
            'Content-Type': 'image/svg+xml',
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
            'Access-Control-Allow-Headers': 'Content-Type',
            'X-UI-Build-Id': UI_BUILD_ID,
            // Long-term caching for static assets
            'Cache-Control': 'public, max-age=31536000, immutable'
          }
        });
      }

      // Return 404 for all other UI paths - STRICT ENFORCEMENT
      return new Response('UI Path Not Found - Only web-runtime UI allowed', {
        status: 404,
        headers: {
          'Access-Control-Allow-Origin': '*',
          'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
          'Access-Control-Allow-Headers': 'Content-Type',
          'X-UI-Build-Id': UI_BUILD_ID
        }
      });
    } catch (error) {
      // Catch all exceptions and log them
      console.error('[WORKER_ROOT_EXCEPTION]', error.message, error.stack);
      
      // Return explicit error response for root path exceptions
      return new Response('WORKER_ROOT_EXCEPTION', {
        status: 500,
        headers: {
          'Content-Type': 'text/plain; charset=utf-8',
          'Access-Control-Allow-Origin': '*',
          'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
          'Access-Control-Allow-Headers': 'Content-Type'
        }
      });
    }
  }
};