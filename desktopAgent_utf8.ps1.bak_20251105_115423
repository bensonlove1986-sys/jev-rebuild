# API endpoint for control panel management
                "/api/control_panel" {
                    if ($method -eq "POST") {
                        try {
                            # Read request body
                            $body = $request.InputStream
                            $encoding = [System.Text.Encoding]::UTF8
                            $reader = New-Object System.IO.StreamReader($body, $encoding)
                            $jsonBody = $reader.ReadToEnd()
                            $reader.Close()
                            
                            # Parse JSON
                            $data = ConvertFrom-Json -InputObject $jsonBody -ErrorAction Stop
                            
                            if ($data -and $data.content) {
                                # Validate content is HTML
                                if ($data.content -match '<!DOCTYPE\s+html' -or $data.content -match '<html') {
                                    # Save content to file
                                    $data.content | Out-File -FilePath $CONTROL_PANEL_PATH -Encoding utf8 -Force
                                    Write-AgentLog "Updated control panel HTML file via API"
                                    
                                    Send-Response $response 200 @{ success = $true; message = "Control panel updated successfully" }
                                } else {
                                    Send-Response $response 400 @{ success = $false; message = "Invalid HTML content" }
                                }
                            } else {
                                Send-Response $response 400 @{ success = $false; message = "Content not provided" }
                            }
                        } catch {
                            Write-ErrorLog "Error updating control panel: $_"
                            Send-Response $response 400 @{ success = $false; message = "Invalid JSON format" }
                        }
                    } elseif ($method -eq "GET") {
                        # Get current control panel file info
                        try {
                            $fileInfo = @{
                                exists = (Test-Path -Path $CONTROL_PANEL_PATH)
                                path = $CONTROL_PANEL_PATH
                            }
                            
                            if ($fileInfo.exists) {
                                $fileStats = Get-Item -Path $CONTROL_PANEL_PATH
                                $fileInfo.lastModified = $fileStats.LastWriteTime.ToString("yyyy-MM-dd HH:mm:ss")
                                $fileInfo.size = $fileStats.Length
                            }
                            
                            Send-Response $response 200 @{ success = $true; fileInfo = $fileInfo }
                        } catch {
                            Write-ErrorLog "Error getting control panel info: $_"
                            Send-Response $response 500 @{ success = $false; message = "Failed to get file info" }
                        }
                    } else {
                        Send-Response $response 405 @{ error = "Method not allowed" }
                    }
                    break
                }
                
                default {
                    Send-Response $response 404 @{ error = "Not found" }
                }
            }
        } catch {
            Write-ErrorLog "ERROR in route handling: $_"
            try {
                # Ensure response is not already sent
                if ($response -ne $null) {
                    Send-Response $response 500 @{ status = "error"; message = "Internal server error" }
                }
            } catch {
                Write-ErrorLog "Failed to send error response for route handling: $_"
            }
        }
    } catch {
        Write-ErrorLog "CRITICAL ERROR in main loop: $_"
        # Ensure response is closed in case of exception
        try { if ($response) { $response.Close() } } catch {}
        # Wait briefly to prevent CPU spike in case of continuous errors
        Start-Sleep -Milliseconds 100
    }
}