# Logging functions
function Write-AgentLog($message) {
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logEntry = "[$timestamp] INFO: $message"
    try {
        Add-Content -Path $AGENT_LOG_PATH -Value $logEntry -Force -ErrorAction SilentlyContinue
    } catch {}
    Write-Host "[INFO] $logEntry"
}

function Write-DebugLog($message) {
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logEntry = "[$timestamp] DEBUG: $message"
    try {
        Add-Content -Path $AGENT_LOG_PATH -Value $logEntry -Force -ErrorAction SilentlyContinue
    } catch {}
    Write-Host "[DEBUG] $logEntry" -ForegroundColor Cyan
}

function Write-WarningLog($message) {
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logEntry = "[$timestamp] WARNING: $message"
    try {
        Add-Content -Path $AGENT_LOG_PATH -Value $logEntry -Force -ErrorAction SilentlyContinue
    } catch {}
    Write-Host "[WARNING] $logEntry" -ForegroundColor Yellow
}

function Write-ErrorLog($errorMessage) {
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logEntry = "[$timestamp] ERROR: $errorMessage"
    try {
        Add-Content -Path $AGENT_LOG_PATH -Value $logEntry -Force -ErrorAction SilentlyContinue
    } catch {}
    Write-Host "[ERROR] $logEntry" -ForegroundColor Red
}

# Enhanced and robust response function
function Send-Response($response, $statusCode, $content, $contentType = "application/json") {
    $outputStream = $null
    
    try {
        Write-DebugLog "Preparing response with status code: $statusCode, content type: $contentType"
        # Set headers first to ensure they are always sent
        $response.StatusCode = $statusCode
        $response.ContentType = "$contentType; charset=utf-8"
        
        # Add CORS headers - in PowerShell, Headers is a collection, not a dictionary
        $corsHeaderExists = $false
        Write-DebugLog "Checking for existing CORS headers"
        foreach ($header in $response.Headers.Keys) {
            Write-DebugLog "Existing header: $header"
            if ($header -eq "Access-Control-Allow-Origin") {
                $corsHeaderExists = $true
                break
            }
        }
        if (-not $corsHeaderExists) {
            $response.Headers.Add("Access-Control-Allow-Origin", "*")
        }
        
        # Process content based on type
        $bytes = $null
        if ($contentType -eq "application/json") {
            # Safely convert to JSON with error handling
            $json = $null
            try {
                Write-DebugLog "Converting response object to JSON"
                $json = $content | ConvertTo-Json -Depth 10 -Compress -ErrorAction Stop
                $bytes = [System.Text.Encoding]::UTF8.GetBytes($json)
            } catch {
                Write-ErrorLog "Failed to convert to JSON: $_"
                # Fallback to simple error message
                $errorMessage = @{ error = "Failed to process response data" }
                $bytes = [System.Text.Encoding]::UTF8.GetBytes(($errorMessage | ConvertTo-Json -Compress))
                $response.StatusCode = 500
            }
        } else {
            # Handle non-JSON content
            if ($content -is [byte[]]) {
                $bytes = $content
            } else {
                $bytes = [System.Text.Encoding]::UTF8.GetBytes($content.ToString())
            }
        }
        
        # Write content length
        $response.ContentLength64 = $bytes.Length
        
        # Get and write to output stream with additional safety measures
        $outputStream = $response.OutputStream
        if ($outputStream -and $outputStream.CanWrite) {
            # Write in chunks to handle large responses better
            $chunkSize = 8192
            for ($i = 0; $i -lt $bytes.Length; $i += $chunkSize) {
                $remaining = $bytes.Length - $i
                $currentChunkSize = [Math]::Min($chunkSize, $remaining)
                $outputStream.Write($bytes, $i, $currentChunkSize)
            }
            
            # Flush the stream to ensure all data is sent
            $outputStream.Flush()
            
            # In PowerShell, we should also close the output stream explicitly
            try {
                $outputStream.Close()
            } catch {
                # Just log, we'll still try to close the response
                Write-ErrorLog "Failed to close output stream: $_"
            }
        }
    } catch {
        Write-ErrorLog "Critical error in Send-Response: $_"
        Write-DebugLog "Send-Response error details - StatusCode: $statusCode, ContentType: $contentType"
        # Try to send a minimal error response if possible
        try {
            $errorBytes = [System.Text.Encoding]::UTF8.GetBytes('{"error":"Internal server error"}')
            $response.StatusCode = 500
            $response.ContentLength64 = $errorBytes.Length
            if ($response.OutputStream.CanWrite) {
                $response.OutputStream.Write($errorBytes, 0, $errorBytes.Length)
                $response.OutputStream.Flush()
            }
        } catch {
            # If we can't even send an error response, just log it
            Write-ErrorLog "Failed to send error response: $_"
        }
    } finally {
        # Always close the response, even if we closed the output stream already
        # This is absolutely critical to prevent connection leaks
        try {
            if ($response -and -not $response.OutputStream.CanWrite) {
                # Response is likely already closed, but we'll try anyway
                $response.Close()
            }
        } catch {
            # Final fallback - just log the error
            Write-ErrorLog "Final attempt to close response failed: $_"
        }
        
        # Set variables to $null to help with garbage collection
        $outputStream = $null
    }
}

# Central Control Heartbeat Function
function Send-HeartbeatToCentralControl {
    param()
    
    if (-not $CENTRAL_CONTROL_ENABLED) {
        return
    }
    
    try {
        # 鏇存柊鏈€鍚庡績璺虫椂闂?        $currentTime = Get-Date
        $agentStatus.lastHeartbeat = $currentTime
        $timestamp = $currentTime.ToString("yyyy-MM-dd HH:mm:ss")
        
        # 鏇存柊杩炴帴鐘舵€佷腑鐨勬渶鍚庡績璺虫椂闂?        $agentStatus.connections.lastHeartbeat = $timestamp
        
        # 濡傛灉杩炴帴宸插缓绔嬶紝妯℃嫙蹇冭烦鎴愬姛
        if ($agentStatus.connections.centralControl) {
            Write-DebugLog "Heartbeat sent to central control system at $timestamp"
            
            # 娣诲姞鍒伴€氫俊鍘嗗彶
            $communicationHistory += "[$timestamp] 鍙戦€佸績璺冲埌涓帶绯荤粺"
        }
        
    } catch {
        Write-WarningLog "Failed to send heartbeat: $_"
        # 璁板綍澶辫触鐨勫績璺?        $failureTimestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        $communicationHistory += "[$failureTimestamp] 蹇冭烦鍙戦€佸け璐? $_"
        # Reconnection logic could be added here
    }
}

# Initialize logging
Write-AgentLog "Starting desktop agent on port $PORT"

# Create HTTP listener
$listener = $null
try {
    $listener = New-Object System.Net.HttpListener
    $listener.Prefixes.Add("http://localhost:$PORT/")
    $listener.Start()
    Write-Host "[INFO] Listening on http://localhost:1818/"
    Write-AgentLog "Server started successfully"
    
    # Start heartbeat timer
    $heartbeatTimer = New-Object System.Timers.Timer
    $heartbeatTimer.Interval = $CENTRAL_CONTROL_HEARTBEAT_INTERVAL
    $heartbeatTimer.AutoReset = $true
    Register-ObjectEvent -InputObject $heartbeatTimer -EventName Elapsed -Action { 
        Send-HeartbeatToCentralControl 
    }
    $heartbeatTimer.Start()
    Write-AgentLog "Heartbeat timer started with interval $CENTRAL_CONTROL_HEARTBEAT_INTERVAL ms"
    
    # Initialize connection statuses
    $agentStatus.connections = @{
        centralControl = $false
        lastHeartbeat = "Never"
        controlPanel = $false
    }
    
    # Create default control panel HTML if it doesn't exist
    if (-not (Test-Path $CONTROL_PANEL_PATH)) {
        try {
            # Default HTML content will be created when /control_panel.html is accessed
            Write-AgentLog "Control panel HTML will be created on first access"
        } catch {
            Write-ErrorLog "Failed to prepare default control panel HTML: $_"
        }
    }
} catch {
    Write-ErrorLog "Failed to start HTTP listener: $_"
    exit 1
}

# Main processing loop
while ($true) {
    try {
            # Get context with timeout
            $context = $listener.GetContext()
            $request = $context.Request
            $response = $context.Response
            $path = $request.Url.AbsolutePath
            $method = $request.HttpMethod
            
            # Log the request with debug details
            $remoteAddress = $context.Request.RemoteEndPoint.Address
            Write-AgentLog "Received request: $method $path"
            Write-DebugLog "Request details - IP: $remoteAddress, User-Agent: $($request.UserAgent)"
        
        # Handle CORS preflight with error handling
        if ($method -eq "OPTIONS") {
            try {
                $response.StatusCode = 200
                $response.Headers.Add("Access-Control-Allow-Origin", "*")
                $response.Headers.Add("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
                $response.Headers.Add("Access-Control-Allow-Headers", "Content-Type")
                $response.Close()
                Write-AgentLog "Handled OPTIONS request successfully"
                continue
            } catch {
                Write-ErrorLog "Error handling OPTIONS request: $_"
                try {
                    $response.StatusCode = 500
                    Send-Response $response 500 @{ status = "error"; message = "Internal server error" }
                } catch {
                    Write-ErrorLog "Failed to send error response for OPTIONS: $_"
                }
                continue
            }
        }
        
        # Route handling with comprehensive error handling
        try {
            switch ($path) {
                "/status" {
                    if ($method -eq "GET") {
                        try {
                            # Ensure connections object exists
                            if (-not $agentStatus.ContainsKey("connections")) {
                                $agentStatus.connections = @{
                                    centralControl = $false
                                    lastHeartbeat = "Never"
                                    controlPanel = $false
                                }
                            }
                            
                            $data = @{
                                running = $true
                                time = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
                                connections = $agentStatus.connections
                                lastHeartbeat = $agentStatus.lastHeartbeat.ToString("yyyy-MM-dd HH:mm:ss")
                                centralControlConnected = $agentStatus.centralControlConnected
                            }
                            Send-Response $response 200 $data
                            Write-AgentLog "Processed status request successfully"
                        } catch {
                            Write-ErrorLog "Failed to process status request: $_"
                            Send-Response $response 500 @{ status = "error"; message = "Failed to process status" }
                        }
                    } else {
                        Send-Response $response 405 @{ error = "Method not allowed" }
                    }
                    break
                }
                
                # Communication history API
                "/communication/history" {
                    if ($method -eq "GET") {
                        try {
                            Write-DebugLog "Processing GET /communication/history request"
                            
                            # Create response with history and count
                            $historyResponse = @{
                                history = $communicationHistory | Select-Object -Last 100
                                count = $communicationHistory.Count
                            }
                            Send-Response $response 200 $historyResponse
                        } catch {
                            Write-ErrorLog "Error processing communication history request: $_"
                            Send-Response $response 500 @{ error = "Failed to retrieve communication history" }
                        }
                    } else {
                        Send-Response $response 405 @{ error = "Method not allowed" }
                    }
                    break
                }
                
                # Central Control Connection APIs
                "/api/central-control/connect" {
                    if ($method -eq "POST") {
                        try {
                            Write-DebugLog "Processing POST /api/central-control/connect request"
                            
                            # Ensure connections object exists
                            if (-not $agentStatus.ContainsKey("connections")) {
                                $agentStatus.connections = @{}
                            }
                            
                            # Simulate connecting to central control
                            $agentStatus.connections.centralControl = $true
                            $agentStatus.centralControlConnected = $true
                            $agentStatus.lastHeartbeat = Get-Date
                            
                            # Add to communication history
                            $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
                            $communicationHistory += "[$timestamp] 杩炴帴鍒颁腑鎺х郴缁? $CENTRAL_CONTROL_URL"
                            
                            Write-AgentLog "Connected to central control system"
                            Send-Response $response 200 @{ message = "鎴愬姛杩炴帴鍒颁腑鎺х郴缁? }
                        } catch {
                            Write-ErrorLog "Error connecting to central control: $_"
                            Send-Response $response 500 @{ message = "杩炴帴涓帶绯荤粺澶辫触: $_" }
                        }
                    } else {
                        Send-Response $response 405 @{ error = "Method not allowed" }
                    }
                    break
                }
                
                "/api/central-control/disconnect" {
                    if ($method -eq "POST") {
                        try {
                            Write-DebugLog "Processing POST /api/central-control/disconnect request"
                            
                            # Ensure connections object exists
                            if (-not $agentStatus.ContainsKey("connections")) {
                                $agentStatus.connections = @{}
                            }
                            
                            # Disconnect
                            $agentStatus.connections.centralControl = $false
                            $agentStatus.centralControlConnected = $false
                            
                            # Add to communication history
                            $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
                            $communicationHistory += "[$timestamp] 鏂紑涓庝腑鎺х郴缁熺殑杩炴帴"
                            
                            Write-AgentLog "Disconnected from central control system"
                            Send-Response $response 200 @{ message = "鎴愬姛鏂紑涓庝腑鎺х郴缁熺殑杩炴帴" }
                        } catch {
                            Write-ErrorLog "Error disconnecting from central control: $_"
                            Send-Response $response 500 @{ message = "鏂紑涓帶绯荤粺杩炴帴澶辫触: $_" }
                        }
                    } else {
                        Send-Response $response 405 @{ error = "Method not allowed" }
                    }
                    break
                }
                
                "/api/central-control/send" {
                    if ($method -eq "POST") {
                        try {
                            Write-DebugLog "Processing POST /api/central-control/send request"
                            
                            # Ensure connections object exists
                            if (-not $agentStatus.ContainsKey("connections")) {
                                $agentStatus.connections = @{}
                            }
                            
                            # Read request body
                            $body = $request.InputStream
                            $encoding = [System.Text.Encoding]::UTF8
                            $reader = New-Object System.IO.StreamReader($body, $encoding)
                            $jsonBody = $reader.ReadToEnd()
                            $reader.Close()
                            
                            # Parse JSON
                            $data = ConvertFrom-Json -InputObject $jsonBody -ErrorAction Stop
                            $message = $data.message
                            
                            # Check if connected
                            if ($agentStatus.connections.centralControl) {
                                $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
                                $communicationHistory += "[$timestamp] 鍙戦€佹秷鎭埌涓帶绯荤粺: $message"
                                
                                # Log the message
                                Write-DebugLog "Message sent to central control: $message"
                                
                                Send-Response $response 200 @{ message = "娑堟伅宸插彂閫佸埌涓帶绯荤粺" }
                            } else {
                                Send-Response $response 400 @{ message = "鏈繛鎺ュ埌涓帶绯荤粺" }
                            }
                        } catch {
                            Write-ErrorLog "Failed to send message to central control system: $_"
                            Send-Response $response 500 @{ message = "鍙戦€佹秷鎭埌涓帶绯荤粺澶辫触" }
                        }
                    } else {
                        Send-Response $response 405 @{ error = "Method not allowed" }
                    }
                    break
                }
                
                "/pause" {
                    if ($method -eq "POST") {
                        try {
                            New-Item -Path $PAUSE_FLAG_PATH -ItemType File -Force | Out-Null
                            Send-Response $response 200 @{ status = "success"; message = "Paused" }
                            Write-AgentLog "System paused"
                        } catch {
                            Write-ErrorLog "Failed to pause: $_"
                            Send-Response $response 500 @{ status = "error"; message = "Failed to pause" }
                        }
                    } else {
                        Send-Response $response 405 @{ error = "Method not allowed" }
                    }
                    break
                }
                
                "/resume" {
                    if ($method -eq "POST") {
                        try {
                            if (Test-Path -Path $PAUSE_FLAG_PATH) {
                                Remove-Item -Path $PAUSE_FLAG_PATH -Force
                            }
                            Send-Response $response 200 @{ status = "success"; message = "Resumed" }
                            Write-AgentLog "System resumed"
                        } catch {
                            Write-ErrorLog "Failed to resume: $_"
                            Send-Response $response 500 @{ status = "error"; message = "Failed to resume" }
                        }
                    } else {
                        Send-Response $response 405 @{ error = "Method not allowed" }
                    }
                    break
                }
                
                "/logs" {
                    if ($method -eq "GET") {
                        try {
                            # Create a timeout for reading logs
                            $logsReadSuccess = $false
                            $logs = @()
                            
                            try {
                                # Use a script block with timeout to prevent hanging
                                $scriptBlock = {
                                    param($logPath)
                                    $logEntries = @()
                                    if (Test-Path -Path $logPath) {
                                        # Limit to 50 lines maximum to ensure quick response
                                        $logEntries = Get-Content -Path $logPath -Tail 50 -ErrorAction SilentlyContinue
                                    }
                                    return $logEntries
                                }
                                
                                # Run with 5 second timeout
                                $job = Start-Job -ScriptBlock $scriptBlock -ArgumentList $AGENT_LOG_PATH
                                if (Wait-Job -Job $job -Timeout 5) {
                                    $logs = Receive-Job -Job $job -ErrorAction SilentlyContinue
                                    $logsReadSuccess = $true
                                } else {
                                    Write-ErrorLog "Timeout reading logs"
                                    Remove-Job -Job $job -Force -ErrorAction SilentlyContinue
                                }
                                
                                # Clean up job
                                Remove-Job -Job $job -ErrorAction SilentlyContinue
                            } catch {
                                Write-ErrorLog "Failed to read logs: $_"
                            }
                            
                            # Always send a response, even if log reading failed
                            $responseData = @{
                                logs = $logs
                                success = $logsReadSuccess
                                timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
                            }
                            
                            # Ensure response is sent immediately
                            Send-Response $response 200 $responseData
                            Write-AgentLog "Processed logs request successfully"
                        } catch {
                            Write-ErrorLog "Error processing logs request: $_"
                            Send-Response $response 500 @{ success = false; error = "Failed to process logs"; timestamp = (Get-Date -Format "yyyy-MM-dd HH:mm:ss") }
                        }
                    } else {
                        Send-Response $response 405 @{ error = "Method not allowed" }
                    }
                    break
                }
                
                "/control_panel.html" {
                    if ($method -eq "GET") {
                        try {
                            # Check if control panel file exists
                            if (Test-Path -Path $CONTROL_PANEL_PATH) {
